 //
 // raw_hid_send() is called at the end, with the same buffer, which was
 // possibly modified with returned values.
+// Keyboard/keymap code can override this to handle its own raw HID messages
+// (e.g. SignalRGB). Return true if handled: VIA/Vial then does nothing more,
+// including NOT echoing the packet back to the host.
+__attribute__((weak)) bool via_command_kb(uint8_t *data, uint8_t length) {
+    return false;
+}
+
 void raw_hid_receive(uint8_t *data, uint8_t length) {
     uint8_t *command_id   = &(data[0]);
     uint8_t *command_data = &(data[1]);
 
+    if (via_command_kb(data, length)) {
+        return;
+    }
+
 #ifdef VIAL_ENABLE
     /* When unlock is in progress, we can only react to a subset of commands */
     if (vial_unlock_in_progress) {
